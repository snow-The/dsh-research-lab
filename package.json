{
  "name": "@snow-the/dsh-research-lab",
  "version": "0.1.0",
  "description": "Research lab for DeepSeek Harness: AutoSci-style wiki (experiments/literature/decisions), ASI-Bench-grade eval rigor ledger, arXiv digest, adversarial paper review, and academic writing checks.",
  "type": "module",
  "main": "./dist/index.js",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "research", "arxiv", "wiki", "benchmark", "deepseek-harness"],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@deepseek-ai/* --log-level=warning",
    "test": "node --test"
  },
  "files": ["dist", "cordis.patch.yml", "LICENSE", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "types": "./dist/index.d.ts",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
